<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>SewerSystem</RootNamespace>
    <AssemblyName>SewerSystem</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.77" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.Text.Json" Version="10.0.13" />
    <PackageReference Include="System.Threading.Channels" Version="9.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ZwDatabaseMgd">
      <HintPath>..\packages\ZWCAD.NetApi.20.26.0\lib\net47\ZwDatabaseMgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="ZwManaged">
      <HintPath>..\packages\ZWCAD.NetApi.20.26.0\lib\net47\ZwManaged.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SancadExtractor\SancadExtractor.csproj" />
    <ProjectReference Include="..\SewerSystem.Contracts\SewerSystem.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="AfterBuildCopy" AfterTargets="Build">
    <ItemGroup>
      <ExtractorFiles Include="$(SolutionDir)SancadExtractor\bin\$(Configuration)\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ExtractorFiles)" DestinationFolder="$(TargetDir)\plugins\extraction\SancadExtractor\%(RecursiveDir)" Condition="Exists('$(SolutionDir)SancadExtractor\bin\$(Configuration)\')" />
  </Target>

</Project>
