<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Sewarage.App"
             xmlns:local="using:Sewarage"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
             
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <x:String x:Key="AppsIcon">/Assets/Icon/Light/apps.svg</x:String>
                    <x:String x:Key="ArrowCounterClockWiseIcon">/Assets/Icon/Light/arrow_counterclockwise.svg</x:String>
                    <x:String x:Key="ArrowExportIcon">/Assets/Icon/Light/arrow_export_ltr.svg</x:String>
                    <x:String x:Key="PlayIcon">/Assets/Icon/Light/play.svg</x:String>
                    <x:String x:Key="SettingsIcon">/Assets/Icon/Light/settings.svg</x:String>
                    <x:String x:Key="StopIcon">/Assets/Icon/Light/stop.svg</x:String>
                    <x:String x:Key="SearchIcon">/Assets/Icon/Light/search.svg</x:String>
                </ResourceDictionary>
                
                <ResourceDictionary x:Key="Dark">
                    <x:String x:Key="SearchIcon">/Assets/Icon/Dark/search.svg</x:String>
                   <x:String x:Key="AppsIcon">/Assets/Icon/Dark/apps.svg</x:String>
                   <x:String x:Key="ArrowCounterClockWiseIcon">/Assets/Icon/Dark/arrow_counterclockwise.svg</x:String>
                   <x:String x:Key="ArrowExportIcon">/Assets/Icon/Dark/arrow_export_ltr.svg</x:String>
                   <x:String x:Key="PlayIcon">/Assets/Icon/Dark/play.svg</x:String>
                   <x:String x:Key="SettingsIcon">/Assets/Icon/Dark/settings.svg</x:String>
                   <x:String x:Key="StopIcon">/Assets/Icon/Dark/stop.svg</x:String>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
